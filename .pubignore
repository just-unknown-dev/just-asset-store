# Pub reads this file instead of .gitignore, so everything .gitignore keeps
# out of the package is listed here too.

# Dart/Flutter tool artifacts
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
pubspec.lock
pubspec_overrides.yaml
/build/
/coverage/

# IDE & editor files
.idea/
*.iml
*.ipr
*.iws
.vscode/

# Git
.git/
.gitignore
.gitattributes

# The repository's own documents: the GitHub setup guide, and the catalog
# and item repository templates (pub would drop their .github folders, so
# they are copied from the repository instead).
/doc/
/templates/

# OS files
.DS_Store
Thumbs.db
